# Template. Safe to commit. Copy to .env.local and fill with real values.
# Neon dashboard > your project > Connect > pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require&channel_binding=require"
# 32+ chars. Generate with: node -p "require('crypto').randomBytes(48).toString('hex')"
AUTH_SECRET="change-me-to-64-plus-random-hex-chars"
# Produção via HTTP em rede local (acesso pelo IP, sem HTTPS): navegadores
# recusam cookie `Secure` em http não-localhost e o login "entra e volta".
# Descomente para esse cenário (depois, refaça `npm run build` + restart).
# COOKIE_SECURE=false
# Bearer token for the scheduled session purge
# (POST /api/auth/sessions/purge, called by cron-job.org). Generate with:
# node -p "require('crypto').randomBytes(32).toString('hex')"
# CRON_SECRET="change-me-to-64-random-hex-chars"
# First admin, created by `npm run db:seed:admin`. Never commit real values.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
