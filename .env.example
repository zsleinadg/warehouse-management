# Template. Safe to commit. Copy to .env.local and fill with real values.
# Neon dashboard > your project > Connect > pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require&channel_binding=require"
# 32+ chars. Generate with: node -p "require('crypto').randomBytes(48).toString('hex')"
AUTH_SECRET="change-me-to-64-plus-random-hex-chars"
# First admin, created by `npm run db:seed:admin`. Never commit real values.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
